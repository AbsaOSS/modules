schema OpensearchAwsmUpboundIoV1beta1DomainStatusAtProviderClusterConfig:
    r"""
    Configuration block for the cluster of the domain. Detailed below.

    Attributes
    ----------
    coldStorageOptions : OpensearchAwsmUpboundIoV1beta1DomainStatusAtProviderClusterConfigColdStorageOptions, default is Undefined, optional
        cold storage options
    dedicatedMasterCount : float, default is Undefined, optional
        Number of dedicated main nodes in the cluster.
    dedicatedMasterEnabled : bool, default is Undefined, optional
        Whether dedicated main nodes are enabled for the cluster.
    dedicatedMasterType : str, default is Undefined, optional
        Instance type of the dedicated main nodes in the cluster.
    instanceCount : float, default is Undefined, optional
        Number of instances in the cluster.
    instanceType : str, default is Undefined, optional
        Instance type of data nodes in the cluster.
    multiAzWithStandbyEnabled : bool, default is Undefined, optional
        Whether a multi-AZ domain is turned on with a standby AZ. For more information, see Configuring a multi-AZ domain in Amazon OpenSearch Service.
    nodeOptions : [OpensearchAwsmUpboundIoV1beta1DomainStatusAtProviderClusterConfigNodeOptionsItems0], default is Undefined, optional
        List of node options for the domain.
    warmCount : float, default is Undefined, optional
        Number of warm nodes in the cluster. Valid values are between 2 and 150. warm_count can be only and must be set when warm_enabled is set to true.
    warmEnabled : bool, default is Undefined, optional
        Whether to enable warm storage.
    warmType : str, default is Undefined, optional
        Instance type for the OpenSearch cluster's warm nodes. Valid values are ultrawarm1.medium.search, ultrawarm1.large.search and ultrawarm1.xlarge.search. warm_type can be only and must be set when warm_enabled is set to true.
    zoneAwarenessConfig : OpensearchAwsmUpboundIoV1beta1DomainStatusAtProviderClusterConfigZoneAwarenessConfig, default is Undefined, optional
        zone awareness config
    zoneAwarenessEnabled : bool, default is Undefined, optional
        Whether zone awareness is enabled, set to true for multi-az deployment. To enable awareness with three Availability Zones, the availability_zone_count within the zone_awareness_config must be set to 3.
    """


    coldStorageOptions?: OpensearchAwsmUpboundIoV1beta1DomainStatusAtProviderClusterConfigColdStorageOptions

    dedicatedMasterCount?: float

    dedicatedMasterEnabled?: bool

    dedicatedMasterType?: str

    instanceCount?: float

    instanceType?: str

    multiAzWithStandbyEnabled?: bool

    nodeOptions?: [OpensearchAwsmUpboundIoV1beta1DomainStatusAtProviderClusterConfigNodeOptionsItems0]

    warmCount?: float

    warmEnabled?: bool

    warmType?: str

    zoneAwarenessConfig?: OpensearchAwsmUpboundIoV1beta1DomainStatusAtProviderClusterConfigZoneAwarenessConfig

    zoneAwarenessEnabled?: bool


