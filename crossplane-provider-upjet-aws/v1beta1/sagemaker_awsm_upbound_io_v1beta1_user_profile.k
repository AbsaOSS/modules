    kernelGatewayAppSettings : SagemakerAwsmUpboundIoV1beta1UserProfileSpecInitProviderUserSettingsKernelGatewayAppSettings, default is Undefined, optional
        kernel gateway app settings
    rSessionAppSettings : SagemakerAwsmUpboundIoV1beta1UserProfileSpecInitProviderUserSettingsRSessionAppSettings, default is Undefined, optional
